{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "ESNext.Array", "ESNext.TypedArrays", "DOM"],
    "types": ["node"]
  },
  "include": ["src", "test"]
}
